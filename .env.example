# ============ 复制成 .env 再填值（.env 已在 .gitignore，不会提交） ============
#   cp .env.example .env

# --- 必填：LLM（DeepSeek 走 OpenAI 兼容接口） ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- 可选：采样温度 ---
# 打分/评测想稳定就设 0；留空用服务端默认
LLM_TEMPERATURE=

# --- 可选：数据目录 ---
# 不设 = 仓库里的 my/（个人练习区，已 gitignore）
# 设了 = 用指定目录，仓库里不留任何个人数据（演示/多机共用都靠它）
#   例：AI_DATA_DIR=/tmp/ai-interview-demo
# AI_DATA_DIR=/tmp/ai-interview-demo

# --- 可选：网页版 ---
# 端口、调用预算（默认=题数+1）、题库路径（默认跟随 my/jd/.active 指向的那套）
#   PORT=8000  WEB_MAX_CALLS=11  WEB_BANK=my/bank/didi-food.json
# PORT=8000
# WEB_MAX_CALLS=11
# WEB_BANK=my/bank/didi-food.json

# --- 可选：Skill 壳脚本的项目路径（默认就是本仓库；换机/公开版用它） ---
#   AI_INTERVIEW_PROJ=/path/to/ai-interview-agent
